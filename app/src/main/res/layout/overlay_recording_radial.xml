<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/radialRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.ScreenRecorder"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/satelliteContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRadialPause"
            style="@style/MaterialButtonIconTonal"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:minWidth="44dp"
            android:minHeight="44dp"
            android:checkable="true"
            android:visibility="gone"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:icon="@drawable/ic_pause"
            android:contentDescription="@string/overlay_recording_radial_desc_pause"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRadialMute"
            style="@style/MaterialButtonIconTonal"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:minWidth="44dp"
            android:minHeight="44dp"
            android:checkable="true"
            android:visibility="gone"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:icon="@drawable/ic_mic"
            android:contentDescription="@string/overlay_recording_radial_desc_mute"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRadialCamera"
            style="@style/MaterialButtonIconTonal"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:minWidth="44dp"
            android:minHeight="44dp"
            android:checkable="true"
            android:visibility="gone"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:icon="@drawable/ic_camera"
            android:contentDescription="@string/overlay_recording_radial_desc_camera_off"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRadialDraw"
            style="@style/MaterialButtonIconTonal"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:minWidth="44dp"
            android:minHeight="44dp"
            android:checkable="true"
            android:visibility="gone"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:icon="@drawable/ic_draw"
            android:contentDescription="@string/overlay_recording_radial_desc_draw_off"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRadialStop"
            style="@style/MaterialButtonIconFilled"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:minWidth="44dp"
            android:minHeight="44dp"
            android:visibility="gone"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:icon="@drawable/ic_stop"
            app:backgroundTint="?attr/colorError"
            app:iconTint="?attr/colorOnError"
            android:contentDescription="@string/overlay_recording_radial_desc_stop"/>
    </FrameLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/centerBubble"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="2dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/radialRedDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginBottom="2dp"
                app:cardCornerRadius="3dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorError"/>

            <Chronometer
                android:id="@+id/radialTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="9.5sp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
