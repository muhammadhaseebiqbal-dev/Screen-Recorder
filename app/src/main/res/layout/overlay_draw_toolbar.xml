<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardMainToolbar"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal|bottom"
    android:theme="@style/Theme.ScreenRecorder"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

    <LinearLayout
        android:id="@+id/drawToolbarRoot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:gravity="center_horizontal">

        <LinearLayout
            android:id="@+id/layoutDragHandle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="2dp"
            android:paddingBottom="6dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnDragHandle"
                android:layout_width="32dp"
                android:layout_height="4dp"
                app:cardCornerRadius="2dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorOutlineVariant"
                android:contentDescription="@string/overlay_draw_toolbar_desc_drag_handle"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvDrawTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overlay_draw_toolbar_title"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUndo"
                style="@style/MaterialButtonIconStandard"
                android:layout_width="38dp"
                android:layout_height="38dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:icon="@drawable/ic_undo"
                app:iconSize="19dp"
                android:contentDescription="@string/overlay_draw_toolbar_desc_undo"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRedo"
                style="@style/MaterialButtonIconStandard"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:icon="@drawable/ic_redo"
                app:iconSize="19dp"
                android:contentDescription="@string/overlay_draw_toolbar_desc_redo"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTouchMode"
                style="@style/MaterialButtonIconTonal"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:checkable="true"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:icon="@drawable/ic_touch_app"
                app:iconSize="19dp"
                android:contentDescription="@string/overlay_draw_toolbar_desc_touch_mode"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearCanvas"
                style="@style/MaterialButtonIconStandard"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:icon="@drawable/ic_delete"
                app:iconSize="19dp"
                android:contentDescription="@string/overlay_draw_toolbar_desc_clear"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseDraw"
                style="@style/MaterialButtonIconFilled"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:icon="@drawable/ic_close"
                app:iconSize="19dp"
                android:contentDescription="@string/overlay_draw_toolbar_desc_close"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/toolsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToolPen"
                style="@style/MaterialButtonIconTonal"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:checkable="true"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:icon="@drawable/ic_gesture"
                app:iconSize="19dp"
                android:contentDescription="@string/overlay_draw_toolbar_desc_pen"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToolArrow"
                style="@style/MaterialButtonIconTonal"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:checkable="true"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:icon="@drawable/ic_draw_arrow"
                app:iconSize="19dp"
                android:contentDescription="@string/overlay_draw_toolbar_desc_arrow"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToolRect"
                style="@style/MaterialButtonIconTonal"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:checkable="true"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:icon="@drawable/ic_draw_rect"
                app:iconSize="19dp"
                android:contentDescription="@string/overlay_draw_toolbar_desc_rectangle"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToolCircle"
                style="@style/MaterialButtonIconTonal"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:checkable="true"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:icon="@drawable/ic_draw_circle"
                app:iconSize="19dp"
                android:contentDescription="@string/overlay_draw_toolbar_desc_circle"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToolEraser"
                style="@style/MaterialButtonIconTonal"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:checkable="true"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:icon="@drawable/ic_eraser"
                app:iconSize="19dp"
                android:contentDescription="@string/overlay_draw_toolbar_desc_eraser"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStrokeSize"
                style="@style/MaterialButtonIconTonal"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:icon="@drawable/ic_stroke_size_2"
                app:iconSize="19dp"
                android:contentDescription="@string/overlay_draw_toolbar_desc_size"/>
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/scrollColors"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/colorContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/colorRed"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/draw_palette_red"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/checkRed"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check"
                        android:visibility="gone"
                        android:contentDescription="@null" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/colorPink"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/draw_palette_pink"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/checkPink"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check"
                        android:visibility="gone"
                        android:contentDescription="@null" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/colorOrange"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/draw_palette_orange"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/checkOrange"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check"
                        android:visibility="gone"
                        android:contentDescription="@null" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/colorYellow"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/draw_palette_yellow"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/checkYellow"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check"
                        android:visibility="gone"
                        android:contentDescription="@null" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/colorGreen"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/draw_palette_green"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/checkGreen"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check"
                        android:visibility="gone"
                        android:contentDescription="@null" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/colorCyan"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/draw_palette_cyan"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/checkCyan"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check"
                        android:visibility="gone"
                        android:contentDescription="@null" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/colorBlue"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/draw_palette_blue"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/checkBlue"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check"
                        android:visibility="gone"
                        android:contentDescription="@null" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/colorPurple"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/draw_palette_purple"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/checkPurple"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check"
                        android:visibility="gone"
                        android:contentDescription="@null" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/colorWhite"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/draw_palette_white"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/checkWhite"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check"
                        android:visibility="gone"
                        android:contentDescription="@null" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/colorBlack"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/draw_palette_black"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/checkBlack"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check"
                        android:visibility="gone"
                        android:contentDescription="@null" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
