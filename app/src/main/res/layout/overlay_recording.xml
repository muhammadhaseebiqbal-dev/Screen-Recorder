<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootCard"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:theme="@style/Theme.ScreenRecorder"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

    <LinearLayout
        android:id="@+id/mainContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <LinearLayout
            android:id="@+id/timerContainer"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/redDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="3.5dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorError"/>

            <Chronometer
                android:id="@+id/timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"/>
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/scrollControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/controlsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingEnd="4dp">

                <com.google.android.material.divider.MaterialDivider
                    android:id="@+id/dividerControls"
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="6dp"
                    app:dividerColor="?attr/colorOutlineVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPause"
                    style="@style/MaterialButtonIconTonal"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:checkable="true"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:icon="@drawable/ic_pause"
                    android:contentDescription="@string/overlay_recording_desc_pause"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMute"
                    style="@style/MaterialButtonIconTonal"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:checkable="true"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:icon="@drawable/ic_mic"
                    android:contentDescription="@string/overlay_recording_desc_mute"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCamera"
                    style="@style/MaterialButtonIconTonal"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:checkable="true"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:icon="@drawable/ic_camera"
                    android:contentDescription="@string/overlay_recording_desc_camera_off"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDraw"
                    style="@style/MaterialButtonIconTonal"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:checkable="true"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:icon="@drawable/ic_draw"
                    android:contentDescription="@string/overlay_recording_desc_draw_off"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStop"
                    style="@style/MaterialButtonIconFilled"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:icon="@drawable/ic_stop"
                    app:backgroundTint="?attr/colorError"
                    app:iconTint="?attr/colorOnError"
                    android:contentDescription="@string/overlay_recording_desc_stop"/>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
